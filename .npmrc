# Published to the public npm registry (no private scope, no auth required).
registry=https://registry.npmjs.org/

# Peer deps (cordis, @deepseek-ai/*) are provided at RUNTIME by the DSH
# installation; do not auto-install them at install time.
auto-install-peers=false

# Corepack-managed pnpm version (see packageManager in package.json).
package-manager-strict=true
# Flat layout: peers + transitive deps resolve by parent-walking from real
# dirs, so @deepseek-ai/schemastery stays hoisted and tsc can name host-half
# schema types in emitted d.ts.
node-linker=hoisted